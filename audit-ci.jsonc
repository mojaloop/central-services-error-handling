{
    "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
    // audit-ci supports reading JSON, JSONC, and JSON5 config files.
    // Only use one of ["low": true, "moderate": true, "high": true, "critical": true]
    "moderate": true,
  // NOTE: Please add as much information as possible to any items added to the allowList
    "allowlist": [        /**
            [11-03-2026] minimatch <11.0.1: potential DoS via globparts amplification (GHSA-g3hv-75wg-m249).
            Transitive only, via minimatch@3.x (eslint/standard, tape, nyc, rimraf@3, standard-version).
            No fixed release on the 3.x line, and minimatch@11 has a different API.
        **/
        "GHSA-g3hv-75wg-m249"
      
    ]
}

